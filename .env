# =====================================================================
# LifePulse - Live AI Configuration
# =====================================================================
# Paste your API key below (Gemini, OpenAI, Groq, or OpenRouter).
# If no key is set, LifePulse automatically uses the built-in CDC/Red Cross
# sub-millisecond Clinical Edge Engine with Zero-Crash Resilience!

# Google Gemini API Key (Recommended - Get a free key at https://aistudio.google.com/)
GEMINI_API_KEY=

# OpenAI API Key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Groq API Key (Ultra-fast Llama 3.3 70B: https://console.groq.com/keys)
GROQ_API_KEY=

# OpenRouter API Key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# Local Ollama Host (e.g. http://127.0.0.1:11434)
OLLAMA_HOST=
